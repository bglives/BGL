# Admin username is optional; when omitted, it defaults to "admin".
LIVEARENA_ADMIN_USERNAME=admin

# Set this as a Replit Secret; do not commit a real password.
LIVEARENA_ADMIN_PASSWORD=replace-with-a-strong-password

# Set this as a Replit Secret; SESSION_SECRET is already provisioned in this project.
SESSION_SECRET=replace-with-a-long-random-value

# DATABASE_URL is provided by the project's PostgreSQL environment.
